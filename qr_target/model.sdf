<?xml version="1.0"?>
<sdf version="1.10">
  <model name="billboard_qr">
    <static>true</static>
    
    <link name="billboard_link">
      <pose>0 0 1.0 1.5708 0 0</pose> 

      <visual name="qr_surface">
        <geometry>
          <box>
            <size>0.5 0.5 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/qr_code.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="billboard_collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
